<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfShark</RootNamespace>
    <AssemblyName>PDF-shar</AssemblyName>
    <Version>1.0.0</Version>
    <!-- WinForms приложение распространяется только для Windows,
         но сборка/публикация артефактов может выполняться и на Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Scanner + OCR библиотеки.
       ВАЖНО: в доступном NuGet-фиде для PdfPig есть только сборки
       '0.1.9-alpha001-patch1' и '1.7.0-custom-5'. Под-пакеты (PdfPig.Core, Fonts,
       Tokens) в фиде есть только версии '1.7.0-custom-5', поэтому используем именно
       её для главного пакета — иначе версии внутри рассогласованы и PdfPig падает
       при открытии документа (FileNotFoundException). -->
  <ItemGroup>
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Drawing" Version="5.2.0" />
  </ItemGroup>

<!-- Рекурсивно включаем все .cs в проект (SDK-style) и встраиваем языковые данные OCR. -->
  <ItemGroup>
    <EmbeddedResource Include="tessdata/eng.traineddata" LogicalName="PdfShark.tessdata.eng.traineddata" />
    <EmbeddedResource Include="tessdata/rus.traineddata" LogicalName="PdfShark.tessdata.rus.traineddata" />
  </ItemGroup>

</Project>